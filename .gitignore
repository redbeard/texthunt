# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets — local only, never commit (the .example template is fine to track)
.env

# Data — personal Slack messages, never commit
data/

# Scratch space for throwaway scripts (the directory is kept, its contents ignored)
tmp/*
!tmp/.gitkeep

# Caches
.pytest_cache/
.ruff_cache/
.ty_cache/
